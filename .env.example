# Razorpay — copy this file to .env and fill in your live keys.
# Client-side Firebase web config (VITE_*) lives in .env already via the Firebase console.
# For the server: drop the downloaded service-account JSON as `firebase-service-account.json`
# in the project root (recommended for local dev), OR set FIREBASE_SERVICE_ACCOUNT here to the
# whole JSON on ONE line. Same value must be added to Vercel (Settings → Environment Variables).
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
# Razorpay dashboard → Settings → Webhooks. Enable `payment_link.paid` event.
RAZORPAY_WEBHOOK_SECRET=